COMPOSE_PROFILES=local-llm
AGENTIC_ENV=development
AGENTIC_IRIS_PORT=52774
AGENTIC_PROVIDER=ollama
AGENTIC_OLLAMA_URL=http://ollama:11434
AGENTIC_MODEL=qwen2.5:3b
# To use OpenAI instead, set AGENTIC_PROVIDER=openai and choose an OpenAI model.
# Comment out COMPOSE_PROFILES=local-llm if the Ollama service is not needed.
# Keep the API key in your local .env file; never commit it.
# AGENTIC_PROVIDER=openai
# AGENTIC_MODEL=gpt-4o-mini
# AGENTIC_OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint:
# AGENTIC_OPENAI_BASE_URL=
AGENTIC_SYSADMIN_URL=http://127.0.0.1:52773/api/admin
# Leave credentials empty for the generated local gateway identity.
AGENTIC_SYSADMIN_USER=
AGENTIC_SYSADMIN_PASSWORD=

# Without a key, auto uses deterministic mock responses and makes no LLM calls.
# Later: copy to .env, insert your key, recreate the container. Never commit .env.
ARGUS_LLM_MODE=auto
OPENAI_API_KEY=
ARGUS_LLM_MODEL=gpt-4.1-mini
ARGUS_TIMEZONE=America/Sao_Paulo
# Set ARGUS_LLM_MODE=mock to forbid LLM requests even if a key is present.
